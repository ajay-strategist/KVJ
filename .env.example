# =============================================================================
# KVJ Analytics — environment template. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real values.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
# Find it in: Supabase dashboard → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=

# Publishable (anon) key. This one is PUBLIC by design — it ships in the browser
# bundle and is protected by Row Level Security. Safe to put here.
VITE_SUPABASE_ANON_KEY=

# --- Auth mode (Phase 6.44) ---------------------------------------------------
# 'legacy' (default): unchanged Supabase Auth (GoTrue) session behavior.
# 'jwt': app-level credentials are verified by the issue-session Edge Function,
#        which mints a Supabase JWT so auth.uid() reliably equals the employee id
#        and RLS is fully effective. Requires the issue-session/refresh-session
#        Edge Functions to be deployed (see supabase/functions/) with their
#        SERVER-SIDE secrets set. Leave unset (legacy) until those are deployed.
# VITE_AUTH_MODE=jwt

# =============================================================================
# NOT stored here (SERVER-SIDE ONLY — never in VITE_* / the browser bundle):
#
#  * The Supabase service_role key — it bypasses RLS. Set as an Edge Function
#    secret: `supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...`
#  * The Supabase JWT signing secret — used by issue-session/refresh-session to
#    sign tokens: `supabase secrets set SUPABASE_JWT_SECRET=...`
#    (If the project uses ASYMMETRIC JWT signing keys instead of the legacy HS256
#    secret, adjust the signing in supabase/functions/_shared/jwt.ts accordingly.)
#  * It must never reach the browser or this file. Server-side only.
#  * Any employee's mailbox password. Per-employee SMTP credentials are entered
#    by each employee in the app's own Mail Configuration screen and encrypted
#    at rest server-side. They never live in a file, in the repo, or in source.
# =============================================================================
